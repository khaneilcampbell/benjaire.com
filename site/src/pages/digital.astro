---
// Digital Solutions: Benjaire's one business, offered directly under the
// Benjaire name. Built from existing components only.
// Service categories lead. Benjaire Flow (the self install kit) is available
// and has its own page at /digital/flow, as is Flow Installed (the kit set up
// for the client). The wider intake service below, with CRM workflows, is
// still in development: never describe it as available here.
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
import Booking from '../components/Booking.astro';
import { SITE } from '../site';

const PROBLEMS = [
  { name: 'Repetitive administrative tasks', text: 'Details copied by hand between email, forms and spreadsheets.' },
  { name: 'Manual client onboarding', text: 'Welcome emails, documents and setup steps assembled from scratch for every new client.' },
  { name: 'Disconnected business applications', text: 'Inquiries, CRM, calendar and project tools that don\'t share information.' },
  { name: 'Inconsistent next steps', text: 'Replies and reminders that depend on someone remembering to send them.' },
  { name: 'Limited operational visibility', text: 'No clear view of where each inquiry or client stands.' },
];

const CAPABILITIES = [
  { name: 'Inquiry capture', text: 'Website and email inquiries collected in one structured place, each with a prompt acknowledgment.' },
  { name: 'Client onboarding', text: 'Welcome messages, documents and setup tasks prepared automatically for every new client.' },
  { name: 'Internal notifications', text: 'The right person alerted when an inquiry or client step needs attention.' },
  { name: 'Timely reminders', text: 'Prompts so no inquiry or onboarding step goes quiet.' },
  { name: 'CRM workflows', text: 'New contacts and their context kept current in the CRM your firm already uses.' },
];

const SERVICES = [
  { name: 'Business Automation', text: 'Streamline repetitive processes, improve information flow, and reduce manual administrative work.',
    uses: ['Client intake', 'Onboarding workflows', 'CRM updates', 'Reminders', 'Internal notifications'] },
  { name: 'AI Integration', text: 'Explore practical ways to incorporate AI into existing business workflows and digital systems.',
    uses: ['Document classification', 'Information organization', 'Workflow assistance', 'Administrative support'] },
  { name: 'Workflow Optimization', text: 'Identify operational bottlenecks and develop more efficient digital processes.',
    uses: ['Process mapping', 'Workflow analysis', 'Systems integration', 'Operational improvements'] },
];

// Discover → Configure → Deploy → Support is a real sequence, so it is numbered.
const STEPS = [
  { name: 'Discover', text: 'We map how inquiries, onboarding and client communication work in your firm today.' },
  { name: 'Configure', text: 'We adapt a standard automation to your tools, wording and team.' },
  { name: 'Deploy', text: 'We launch it alongside your existing systems and test it with real workflows.' },
  { name: 'Support', text: 'Optional ongoing support: we monitor, adjust and improve it as your firm grows.' },
];

const description = 'Benjaire develops practical automation and AI solutions that help professional services firms streamline operations and simplify client onboarding.';
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/digital#service`,
  name: 'Digital Solutions by Benjaire',
  serviceType: 'Business process automation',
  description,
  url: `${SITE.url}/digital`,
  provider: { '@id': `${SITE.url}/#organization` },
  audience: { '@type': 'BusinessAudience', name: 'Professional services firms' },
};
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Digital Solutions" shareTitle="Digital Solutions | Business Automation & AI | Benjaire" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceLd)} />

  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Digital Solutions by Benjaire</p>
      <h1>Intelligent solutions for <span>modern business.</span></h1>
      <p class="lead mb-5">Benjaire develops practical technology and automation solutions that help businesses streamline operations, improve efficiency, and simplify everyday workflows.</p>
      <div class="actions">
        <a class="btn primary" href="/contact?category=digital#inquiry">Discuss your workflow <span aria-hidden="true">→</span></a>
        <a class="btn ghost" href="#services">See service categories</a>
      </div>
      <PageBand label="Inquiries in · sorted · answered" />
    </div>
  </section>

  <section class="sec raised band-section" id="flow" aria-labelledby="flow-title">
    <div class="wrap two">
      <div>
        <p class="eyebrow">Available now</p>
        <span class="badge">New · v1.0</span>
        <h2 id="flow-title">Benjaire Flow.</h2>
      </div>
      <div>
        <p class="lead mb-5">The inquiry system for service firms, and our first product: six n8n workflows that sort website inquiries with Claude, alert you with one tap status buttons, confirm receipt to the sender and remind you before leads go cold.</p>
        <div class="actions"><a class="btn primary" href="/digital/flow">See Benjaire Flow <span aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  <section class="sec band-section" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="eyebrow">Service categories</p><h2 id="services-title">Where we can help.</h2></div>
        <p class="muted">Three capability areas, each delivered directly by Benjaire as a defined scope project with optional ongoing support. All are in business development and service validation.</p>
      </div>
      <ul class="rows">
        {SERVICES.map((s) => <li class="row"><h3>{s.name}</h3><div><p>{s.text}</p><ul class="taglist" aria-label={`${s.name} use cases`}>{s.uses.map((u) => <li>{u}</li>)}</ul></div></li>)}
      </ul>
    </div>
  </section>

  <section class="sec raised band-section" aria-labelledby="solve">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="eyebrow">What we solve</p><h2 id="solve">The work behind the client work.</h2></div>
        <p class="muted">Small firms often run on manual steps between tools that don't talk to each other. Business process automation starts there.</p>
      </div>
      <ul class="rows">
        {PROBLEMS.map((p) => <li class="row"><h3>{p.name}</h3><p>{p.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="sec band-section" id="intake" aria-labelledby="intake-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Example use case</p>
          <span class="badge">In development</span>
          <h2 id="intake-title">Client intake &amp; workflow automation.</h2>
        </div>
        <p class="muted">One example of what Business Automation can do for a small consulting firm or agency: we automate how inquiries arrive, how new clients are onboarded and what happens next. It is in development, and firms that talk to us now can help shape it. Its first part is available today as <a href="/digital/flow#pricing">Benjaire Flow, set up for you</a>.</p>
      </div>
      <ul class="rows">
        {CAPABILITIES.map((c) => <li class="row"><h3>{c.name}</h3><p>{c.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="sec raised band-section" aria-labelledby="how">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="eyebrow">How it works</p><h2 id="how">Four steps, one standard.</h2></div>
        <p class="muted">Defined scope projects built from standard building blocks, configured for your firm rather than built from scratch, with optional ongoing support after launch.</p>
      </div>
      <ol class="pillars four">
        {STEPS.map((s, i) => <li class="pillar"><span class="num" aria-hidden="true">{pad(i + 1)}</span><h3>{s.name}</h3><p>{s.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="sec band-section" aria-labelledby="serve">
    <div class="wrap two">
      <div><p class="eyebrow">Who we serve</p><h2 id="serve" class="statement">Professional services firms that want more time for clients and less time on admin.</h2></div>
      <dl class="facts">
        <div class="fact"><dt>Primary focus</dt><dd>Consulting firms and agencies</dd></div>
        <div class="fact"><dt>Also</dt><dd>Business advisory firms</dd></div>
        <div class="fact"><dt>Team size</dt><dd>About 5 to 30 people</dd></div>
        <div class="fact"><dt>Status</dt><dd>Business development and service validation</dd></div>
        <div class="fact"><dt>Offered by</dt><dd><a href="/about">Benjaire, {SITE.location}</a></dd></div>
      </dl>
    </div>
  </section>

  <Booking />

  <section class="band dark" aria-labelledby="build-smarter">
    <div class="wrap">
      <img class="band-mark" src="/brand/benjaire-monogram-pearl.svg" alt="" width="53" height="56" />
      <p class="eyebrow center">Get started</p>
      <h2 id="build-smarter">Build smarter business operations.</h2>
      <p>Tell us how your firm handles inquiries and onboarding today.</p>
      <div class="actions center"><a class="btn primary" href="#book">Book a call</a><a class="btn ghost" href="/contact?category=digital#inquiry">Contact Benjaire</a></div>
    </div>
  </section>
</Base>
