---
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
import { CATEGORIES, SITE, TURNSTILE_SITE_KEY } from '../site';
import Booking from '../components/Booking.astro';
---
<Base title="Contact" shareTitle="Contact Benjaire | Digital Solutions and Partnerships" pageType="ContactPage" description="Contact Benjaire in New York about digital solutions, Benjaire Flow, business partnerships or general questions about the company.">
  <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Get in touch</p>
      <h1>Let's talk.</h1>
      <p class="lead">Digital solutions, Benjaire Flow, partnerships and general company inquiries. Every message is reviewed directly by our team.</p>
      <PageBand label="Every message reaches the right person" />
    </div>
  </section>

  <section class="band-section">
    <div class="wrap contact-grid">
      <div class="contact-aside">
        <h2>Direct line</h2>
        <p class="muted mb-4">Prefer email? Write to us directly. We review every inquiry and respond as soon as possible.</p>
        <dl class="facts">
          <div class="fact"><dt>Email</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
          <div class="fact"><dt>Response time</dt><dd>As soon as possible</dd></div>
          <div class="fact"><dt>Location</dt><dd>{SITE.location}</dd></div>
        </dl>
      </div>

      <div class="contact-form">
        <form class="form" id="inquiry" method="post" action="/api/contact" novalidate>
          <fieldset class="field" id="f-category">
            <legend>What's this about? <span class="req" aria-hidden="true">*</span></legend>
            <div class="chips">
              {CATEGORIES.map((c, i) => (
                <label class="chip">
                  <input type="radio" name="category" value={c.value} required checked={i === 0} />
                  <span>{c.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="f-row">
            <div class="field" id="f-name">
              <label class="label" for="name">Name <span class="req" aria-hidden="true">*</span></label>
              <input class="input" id="name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="name-err" />
              <span class="error" id="name-err" aria-live="polite"></span>
            </div>
            <div class="field" id="f-email">
              <label class="label" for="email">Email <span class="req" aria-hidden="true">*</span></label>
              <input class="input" id="email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="email-err" />
              <span class="error" id="email-err" aria-live="polite"></span>
            </div>
          </div>

          <div class="field">
            <label class="label" for="company">Company</label>
            <input class="input" id="company" name="company" type="text" autocomplete="organization" maxlength="160" placeholder="Optional" />
          </div>

          <div class="field" id="f-message">
            <label class="label" for="message">Message <span class="req" aria-hidden="true">*</span></label>
            <textarea class="input" id="message" name="message" required minlength="20" maxlength="5000" placeholder="Tell us about your company, product or idea." aria-describedby="message-err"></textarea>
            <span class="error" id="message-err" aria-live="polite"></span>
          </div>

          <div class="hp" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="field" id="f-consent">
            <label class="consent">
              <input id="consent" name="consent" type="checkbox" required aria-describedby="consent-err" />
              <span>I agree that Benjaire may use these details to respond to my inquiry, as described in the <a href="/privacy">Privacy Policy</a>.</span>
            </label>
            <span class="error" id="consent-err" aria-live="polite"></span>
          </div>

          <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-action="contact" data-theme="light" data-size="flexible"></div>

          <div><button class="btn primary" type="submit">Send message &rarr;</button></div>
          <p class="form-status" id="form-status" role="status" hidden></p>
        </form>
      </div>
    </div>
  </section>

  <Booking eyebrow="Prefer to talk?" title="Book a call instead." text="Pick a time that suits you and tell us what you would like to cover. We will come prepared." />

</Base>

<script>
  import { initContactForm } from '../scripts/contact';
  initContactForm();
</script>
