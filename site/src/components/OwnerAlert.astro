---
// A sample Flow owner alert, drawn in HTML so it stays sharp and readable at
// any width. Decorative stand-in for the real email: every value is sample data.
// The homepage cycles `data-alert` through more samples (src/scripts/home.ts).
interface Props { class?: string; count?: string }
const { class: cls, count = 'Sample 1 of 3' } = Astro.props;
---
<figure class:list={['owner-alert', cls]} data-alert aria-label="Sample Benjaire Flow owner alert">
  <header><i></i><i></i><i></i><span>Owner alert</span><span class="oa-count" data-alert-count>{count}</span></header>
  <div class="oa-body" data-alert-body>
    <p class="oa-live"><b aria-hidden="true"></b>Sorted by Claude · just now</p>
    <p class="oa-title" data-alert-title>[Urgent] New inquiry: Dana Lee, Lee &amp; Co</p>
    <ul class="oa-tags" data-alert-tags><li>Branding</li><li class="urgent">Urgent</li><li>$5,000</li></ul>
    <p class="oa-reply" data-alert-reply>Hi Dana, thank you for reaching out. A launch next week is a tight window…</p>
    <p class="oa-acts" aria-hidden="true"><span>I replied</span><span class="hl">Became a client</span><span class="o">Close</span></p>
  </div>
</figure>

<style>
  .owner-alert { margin: 0; width: min(420px, 100%); background: var(--paper); color: var(--fg); border-radius: var(--radius-md); box-shadow: var(--shadow-3), 0 0 0 1px rgba(255, 255, 255, .4); overflow: hidden; transition: box-shadow var(--dur-slow) var(--ease); }
  .owner-alert.ping { box-shadow: var(--shadow-3), 0 0 0 1px rgba(255, 255, 255, .4), 0 0 0 6px rgba(143, 179, 220, .3), 0 0 60px rgba(143, 179, 220, .35); }
  .owner-alert header { display: flex; align-items: center; gap: 6px; padding: 11px 16px; border-bottom: 1px solid var(--line); font: 400 10.5px/1 var(--mono); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--fg-low); }
  .owner-alert header i { width: 8px; height: 8px; border-radius: 50%; background: var(--surface); }
  .owner-alert header span:first-of-type { margin-left: 8px; }
  .oa-count { margin-left: auto; }
  .oa-body { padding: 16px 18px 18px; display: grid; gap: 10px; transition: opacity var(--dur-base) var(--ease), transform var(--dur-base) var(--ease); }
  .oa-body.out { opacity: 0; transform: translateY(6px); }
  .oa-live { display: flex; align-items: center; gap: 8px; font: 400 10.5px/1 var(--mono); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--signal); }
  .oa-live b { width: 7px; height: 7px; border-radius: 50%; background: var(--signal); }
  .oa-title { font: 600 15.5px/1.3 var(--sans); color: var(--fg); }
  .oa-tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; }
  .oa-tags li { font-size: 12px; font-weight: 500; padding: 5px 10px; border-radius: var(--radius-pill); background: var(--bg); color: var(--fg); }
  .oa-tags li.urgent { background: var(--danger-tint); color: var(--danger); }
  .oa-reply { font-size: 14px; line-height: 1.5; color: var(--fg-mid); border-left: 2px solid var(--line-mid); padding-left: 12px; }
  .oa-acts { display: flex; flex-wrap: wrap; gap: 6px; }
  .oa-acts span { font-size: 12.5px; font-weight: 500; padding: 9px 13px; border-radius: var(--radius-pill); background: var(--fg); color: var(--on-accent); }
  .oa-acts span.hl { background: var(--signal); }
  .oa-acts span.o { background: transparent; color: var(--fg); box-shadow: inset 0 0 0 1px var(--line-mid); }
  @media (prefers-reduced-motion: no-preference) { .oa-live b { animation: oa-pulse 1.6s ease-in-out infinite; } }
  @keyframes oa-pulse { 50% { opacity: .25; } }
</style>
