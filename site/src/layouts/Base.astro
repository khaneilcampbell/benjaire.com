---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
// Preload the two faces used above the fold so text doesn't re-wrap (layout shift).
import archivoVar from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

interface Props {
  /** Short page name, matching its nav or footer label. Used for the breadcrumb and
   *  the tab title "<title> · Benjaire" (the homepage, with no title, is just "Benjaire") */
  title?: string;
  /** Longer, descriptive title for share cards (og:title) and the WebPage schema name.
   *  Kept out of <title> so tabs stay short and every page follows one pattern. */
  shareTitle?: string;
  description?: string;
  noindex?: boolean;
  /** schema.org WebPage subtype for this page, e.g. AboutPage, ContactPage */
  pageType?: string;
  /** Homepage: the nav floats over a full-bleed hero image */
  hero?: boolean;
  /** Share card for this page, a 1200x630 PNG under public/ (default: the company card) */
  ogImage?: string;
  ogImageAlt?: string;
}
const { title, shareTitle, description = SITE.metaDescription, noindex = false, pageType = 'WebPage', hero = false, ogImage: ogPath = '/og/benjaire-og.png', ogImageAlt = `Benjaire: ${SITE.slogan.join(' ')}` } = Astro.props;
const brandTitle = `${SITE.name} | ${SITE.slogan.join(' ')}`;
const tabTitle = title ? `${title} · ${SITE.name}` : SITE.name;
// Share cards carry the tagline on the homepage; other pages share their descriptive title.
const ogTitle = shareTitle ?? (title ? tabTitle : brandTitle);
// Clean URLs: /about (not /about.html), / (not /index.html).
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(cleanPath, SITE.url).href;
const ogImage = new URL(ogPath, SITE.url).href;

// Organization and WebSite go on every indexable page so each page's
// isPartOf / about references resolve within that page.
const pageLd = noindex
  ? null
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': `${SITE.url}/#organization`,
          name: SITE.name,
          legalName: SITE.legalName,
          url: `${SITE.url}/`,
          logo: { '@type': 'ImageObject', url: `${SITE.url}/icons/logo-512.png`, width: 512, height: 512 },
          description: SITE.description,
          slogan: SITE.slogan.join(' '),
          foundingDate: String(SITE.founded),
          address: { '@type': 'PostalAddress', addressLocality: 'New York', addressRegion: 'NY', addressCountry: 'US' },
          email: SITE.email,
          contactPoint: { '@type': 'ContactPoint', contactType: 'business inquiries', email: SITE.email, url: `${SITE.url}/contact` },
        },
        { '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.name, publisher: { '@id': `${SITE.url}/#organization` } },
        {
          '@type': pageType,
          '@id': `${canonical}#webpage`,
          url: canonical,
          name: ogTitle,
          description,
          isPartOf: { '@id': `${SITE.url}/#website` },
          about: { '@id': `${SITE.url}/#organization` },
        },
        ...(cleanPath === '/'
          ? []
          : [
              {
                '@type': 'BreadcrumbList',
                itemListElement: [
                  { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
                  { '@type': 'ListItem', position: 2, name: title ?? SITE.name, item: canonical },
                ],
              },
            ]),
      ],
    };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f4f6f8" />
    <link rel="preload" href={archivoVar} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <!-- Tab icon: the bare graphite B on a transparent ground (pearl in dark
         browser chrome via the SVG's prefers-color-scheme). Google Search uses
         the square PNGs (multiples of 48px) for the result favicon. Bump ?v=
         when the icon changes: browsers (Safari most of all) cache favicons
         hard. The touch icon and manifest icons stay as pearl tiles. -->
    <link rel="icon" href="/icons/favicon-48.png?v=2" type="image/png" sizes="48x48" />
    <link rel="icon" href="/icons/favicon-96.png?v=2" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icons/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {pageLd && <script type="application/ld+json" set:html={JSON.stringify(pageLd)} />}
    <script is:inline>document.documentElement.classList.add('js')</script>
    <slot name="head" />
  </head>
  <body class={hero ? 'has-hero' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
