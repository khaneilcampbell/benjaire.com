{
  "name": "benjaire-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/security-headers.mjs dist",
    "preview": "astro preview",
    "check": "astro check",
    "test:links": "node scripts/check-links.mjs dist",
    "test:a11y": "node scripts/a11y.mjs dist",
    "ci": "astro check && npm run check:worker && npm run test:worker && npm run build && node scripts/check-links.mjs dist && node scripts/check-seo.mjs dist",
    "test:seo": "node scripts/check-seo.mjs dist",
    "test:worker": "node --test worker/lib.test.ts",
    "check:worker": "wrangler types worker/worker-configuration.d.ts && tsc -p worker"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
