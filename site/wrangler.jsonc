// Cloudflare Workers deployment (ADR-0002, ADR-0004).
// Static pages are served straight from ./dist. Only /api/* reaches the
// Worker script (the contact-form handler). Clean URLs: /about serves
// about.html and /about.html redirects to /about. benjaire.com and
// www.benjaire.com are attached as custom domains in the Cloudflare
// dashboard, not here; a Redirect Rule sends www to the apex.
//
// Secrets (set in the dashboard, never in this public repo):
//   TURNSTILE_SECRET_KEY  Turnstile secret for the contact form
//   CONTACT_TO            verified Email Routing destination for inquiries
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "benjaire-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Preview addresses: <name>.<account>.workers.dev for main, plus a
  // per-branch preview URL for pull requests. Search engines are pointed at
  // benjaire.com by each page's canonical tag.
  "workers_dev": true,
  "preview_urls": true,
  // Keep Worker logs (contact-form errors) in the dashboard. Free tier.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/google16283c1e65acebfc.html"]
  },
  "vars": {
    "MAIL_FROM": "website@benjaire.com",
    "ALLOWED_HOSTS": "benjaire.com,www.benjaire.com,benjaire-com.benjaireco.workers.dev",
    // Live Stripe prices for /api/checkout (public IDs, not secrets). Sessions
    // are only created once STRIPE_SECRET_KEY is set; until then, and on any
    // Stripe error, buyers go to the tier's Payment Link. Sales tax is collected
    // on every tier (Stripe Tax); turn it on in each Payment Link to match.
    "STRIPE_TIERS": {
      "starter": { "price": "price_1URQGtPiFF3Kq67q3qVj08sB", "automaticTax": true },
      "professional": { "price": "price_1US9cXPiFF3Kq67qIvlS2lwb", "automaticTax": true }
    }
  },
  // Cloudflare Email Routing: may only send to verified destination addresses.
  "send_email": [{ "name": "SEND_EMAIL" }],
  // 5 submissions per minute per visitor IP.
  // SITE_LIMITER: site-wide caps (keys site:contact and site:checkout), 20 per
  // minute each, so many visitors together can't run up email or Stripe use.
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "SITE_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  // Pull request previews (`wrangler preview` in Workers Builds). Bindings are
  // not inherited, so each one is restated. Preview hostnames already pass the
  // origin check (worker/lib.ts), and previews get their own rate-limit
  // namespace. Email Routing only delivers to verified addresses, so a preview
  // form submission reaches the same inbox as production.
  "previews": {
    "vars": {
      "MAIL_FROM": "website@benjaire.com",
      "ALLOWED_HOSTS": "benjaire-com.benjaireco.workers.dev",
      // Test-mode prices go here (with an sk_test_ STRIPE_SECRET_KEY preview
      // secret) to run checkout end to end on a preview. Empty: Payment Links.
      "STRIPE_TIERS": {}
    },
    "send_email": [{ "name": "SEND_EMAIL" }],
    "ratelimits": [
      { "name": "CONTACT_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
      { "name": "SITE_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
    ]
  }
}
